# Replace {{resetOtp}} with the 6-digit code from your email.
POST {{baseUrl}}/auth/password-reset/verify-otp
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "{{resetOtp}}",
  "newPassword": "NewStrongPass123!"
}

