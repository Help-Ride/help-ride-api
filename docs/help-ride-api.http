### DRIVER SUMMARY (RIDES + EARNINGS)
GET {{baseUrl}}/drivers/me/summary
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### DRIVER EARNINGS LEDGER (PAGINATED)
GET {{baseUrl}}/drivers/me/earnings?status=succeeded&limit=20
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### GET DRIVER PROFILE (by userId)
GET {{baseUrl}}/drivers/{{userId}}
Accept: application/json

###

### UPDATE DRIVER PROFILE
PUT {{baseUrl}}/drivers/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "carColor": "Matt Black",
  "carModel": "Corolla SE"
}

###

# Set this from GET DRIVER PROFILE response (DriverProfile.id)
@vehicleId =

### UPDATE VEHICLE (ALIAS, SINGLE VEHICLE)
PUT {{baseUrl}}/drivers/{{userId}}/vehicles/{{vehicleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "carColor": "Blue"
}

###

### DELETE VEHICLE (ALIAS, SINGLE VEHICLE)
DELETE {{baseUrl}}/drivers/{{userId}}/vehicles/{{vehicleId}}
Authorization: Bearer {{accessToken}}

###

### CHECK CURRENT USER ROLE AFTER DRIVER PROFILE DELETE
# Expect: roleDefault = "passenger"
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

