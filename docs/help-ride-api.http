################################################
### 👤 USERS
################################################

### GET USER PROFILE (PUBLIC)
GET {{baseUrl}}/users/{{userId}}
Accept: application/json

###

### UPDATE OWN USER PROFILE
# If `email` or `phone` changes, the new value is stored as pending until OTP verification succeeds.
# The active verified email/phone stays unchanged until verification completes.
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Name",
  "phone": "{{phone}}"
}

###

### DELETE MY ACCOUNT
# Deletes the current account and automatically cancels active rides/bookings/requests/offers.
# Any refunds or driver payouts already in progress continue processing after deletion.
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}

###

### UPDATE MY LIVE LOCATION (CALL ON LOGIN / APP OPEN)
PUT {{baseUrl}}/users/me/location
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "lat": 43.4643,
  "lng": -80.5204,
  "accuracyMeters": 12,
  "recordedAt": "2026-02-11T10:20:00.000Z"
}

