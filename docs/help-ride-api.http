################################################
### 📌 RIDE REQUESTS (WHEN NO MATCHING RIDES)
################################################

### CREATE JIT PAYMENT INTENT (PASSENGER, <= 2 HOURS TO DEPARTURE)
# On successful payment webhook, ride request is created, paid JIT state is persisted,
# and nearby drivers are notified.
# If no driver is matched before the JIT timeout/departure, the request auto-expires
# and Stripe refund is initiated.
POST {{baseUrl}}/ride-requests/jit/intent
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "preferredDate": "2026-02-02T18:00:00.000Z",
  "preferredTime": "18:00",
  "seatsNeeded": 1,
  "rideType": "one-time",
  "tripType": "one-way",
  "savePaymentMethod": false
}

###

### CREATE RIDE REQUEST (PASSENGER, VERIFIED)
# NOTE: For departures within 2 hours, call /ride-requests/jit/intent first.
# Nearby drivers (with recent location updates) are notified automatically.
POST {{baseUrl}}/ride-requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "preferredDate": "2025-12-20T08:00:00.000Z",
  "preferredTime": "08:00",
  "arrivalTime": "10:30",
  "seatsNeeded": 1,
  "rideType": "one-time",
  "tripType": "one-way"
}

###

### PUBLIC LIST RIDE REQUESTS (OFFERING/PENDING BY DEFAULT)
GET {{baseUrl}}/ride-requests?fromCity=Waterloo&toCity=Toronto
Accept: application/json

###

### PUBLIC LIST RIDE REQUESTS (PICKUP NEARBY)
GET {{baseUrl}}/ride-requests?lat=43.4643&lng=-80.5204&radiusKm=25&limit=20
Accept: application/json

###

### MY RIDE REQUESTS (PASSENGER)
# Touching ride-request endpoints also sweeps stale JIT requests so unmatched paid
# requests move to EXPIRED and refund flow is triggered if needed.
GET {{baseUrl}}/ride-requests/me/list
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Set this from the list response
@rideRequestId = 24a28eec-6c11-46dd-b774-a59f0cd605dd

### GET SINGLE RIDE REQUEST (PUBLIC)
GET {{baseUrl}}/ride-requests/{{rideRequestId}}
Accept: application/json

###

### GET RIDE REQUEST DETAIL (PUBLIC, INCLUDES OFFERS)
GET {{baseUrl}}/ride-requests/{{rideRequestId}}/detail
Accept: application/json

###

### UPDATE OWN RIDE REQUEST
PUT {{baseUrl}}/ride-requests/{{rideRequestId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "preferredTime": "09:30",
  "arrivalTime": "12:00",
  "seatsNeeded": 2
}

###

### CANCEL OWN RIDE REQUEST
# NOTE: For JIT requests, this also initiates Stripe refund before cancellation.
POST {{baseUrl}}/ride-requests/{{rideRequestId}}/cancel
Authorization: Bearer {{accessToken}}

###

### DELETE / CANCEL OWN RIDE REQUEST (LEGACY ALIAS)
DELETE {{baseUrl}}/ride-requests/{{rideRequestId}}
Authorization: Bearer {{accessToken}}

###

### REALTIME ACCEPT CALLBACK (SERVER-TO-SERVER, NO JWT)
POST {{baseUrl}}/ride-requests/{{rideRequestId}}/accept
X-REALTIME-SECRET: {{realtimeSecret}}
Content-Type: application/json

{
  "driverId": "{{driverId}}",
  "rideId": "{{rideId}}",
  "seatsOffered": 1,
  "pricePerSeat": 20
}

###

################################################
### 🧾 RIDE REQUEST OFFERS (DRIVER ↔ PASSENGER)
################################################

### DRIVER: CREATE OFFER FOR REQUEST
POST {{baseUrl}}/ride-requests/{{rideRequestId}}/offers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rideId": "{{rideId}}",
  "seatsOffered": 1
}

###

### PASSENGER: LIST OFFERS FOR A REQUEST
GET {{baseUrl}}/ride-requests/{{rideRequestId}}/offers
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### DRIVER: LIST MY OFFERS
GET {{baseUrl}}/ride-requests/offers/me/list
Authorization: Bearer {{accessToken}}
Accept: application/json

###

@offerId = 00000000-0000-0000-0000-000000000000

### PASSENGER: ACCEPT OFFER (CONFIRMS RIDE)
PUT {{baseUrl}}/ride-requests/{{rideRequestId}}/offers/{{offerId}}/accept
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### PASSENGER: REJECT OFFER
PUT {{baseUrl}}/ride-requests/{{rideRequestId}}/offers/{{offerId}}/reject
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### DRIVER: CANCEL OFFER
PUT {{baseUrl}}/ride-requests/{{rideRequestId}}/offers/{{offerId}}/cancel
Authorization: Bearer {{accessToken}}
Accept: application/json

