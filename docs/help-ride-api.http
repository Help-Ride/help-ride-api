################################################
### 🚗 RIDES – DRIVER FLOW
################################################

###########################################
### 🚗 CREATE RIDE  (requires driver token)
###########################################
POST {{baseUrl}}/rides
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-20T08:00:00.000Z",
  "arrivalTime": "2025-12-21T08:00:00.000Z",
  "stops": ["Downtown", "Union Station"],
  "amenities": ["ac", "wifi", "music"],
  "additionalNotes": "Pickup near front entrance",
  "seatsTotal": 1,
  "pricePerSeat": 22
}

###

###########################################
### ✏️ UPDATE RIDE (driver only)
###########################################
PUT {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-20T08:00:00.000Z",
  "arrivalTime": "2025-12-21T08:00:00.000Z",
  "stops": ["Downtown", "Union Station"],
  "amenities": ["wifi", "pet_friendly"],
  "additionalNotes": "Luggage space available",
  "seatsTotal": 1,
  "pricePerSeat": 22
}

###

### SEARCH RIDES (PUBLIC)
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
GET {{baseUrl}}/rides?fromCity=Waterloo&toCity=Toronto&seats=1
Accept: application/json

###

### SEARCH RIDES (GEOLOCATION)
GET {{baseUrl}}/rides?fromLat=43.4643&fromLng=-80.5204&toLat=43.6532&toLng=-79.3832&radiusKm=25&seats=1
Accept: application/json

###

### GET MY RIDES  (driver only)
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
GET {{baseUrl}}/rides/me/list
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### SET A RIDE ID FROM PREVIOUS RESPONSE
# Example:
# @rideId = 8cc76017-9a9e-4b4d-88fa-6761c2de1685


### GET RIDE BY ID
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
GET {{baseUrl}}/rides/{{rideId}}
Accept: application/json

###

### UPDATE RIDE (driver only)
PUT {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-15T15:00:00.000Z",
  "arrivalTime": "2025-12-15T17:00:00.000Z",
  "stops": ["Union Station"],
  "amenities": ["wifi", "child_seat"],
  "additionalNotes": "One small luggage allowed",
  "pricePerSeat": 22.5,
  "seatsTotal": 4
}

###

### DELETE / CANCEL RIDE (driver only)
DELETE {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}

###

###########################################
### 🚦 RIDE LIFECYCLE (driver only)
###########################################
### START RIDE
POST {{baseUrl}}/rides/{{rideId}}/start
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### START RIDE (PUT alias)
PUT {{baseUrl}}/rides/{{rideId}}/start
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### COMPLETE RIDE
POST {{baseUrl}}/rides/{{rideId}}/complete
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### COMPLETE RIDE (PUT alias)
PUT {{baseUrl}}/rides/{{rideId}}/complete
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### CANCEL RIDE (with reason)
# Refund is initiated for all paid confirmed bookings.
POST {{baseUrl}}/rides/{{rideId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Driver unavailable"
}

###

### CANCEL RIDE (PUT alias)
# Refund is initiated for all paid confirmed bookings.
PUT {{baseUrl}}/rides/{{rideId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Driver unavailable"
}

