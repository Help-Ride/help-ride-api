################################################
### 🚗 RIDES – DRIVER FLOW
################################################

###########################################
### 💸 RIDE PRICING PREVIEW (driver only)
###########################################
POST {{baseUrl}}/rides/pricing-preview
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-20T08:00:00.000Z",
  "seatsTotal": 3,
  "pricePerSeat": 0
}

###

###########################################
### 🚗 CREATE RIDE  (requires driver token)
# After 5 completed driver rides, this can return 403 `DRIVER_COMPLIANCE_REQUIRED`
# until Stripe Connect setup and ownership/registration upload are completed.
###########################################
POST {{baseUrl}}/rides
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-20T08:00:00.000Z",
  "arrivalTime": "2025-12-21T08:00:00.000Z",
  "stops": ["Downtown", "Union Station"],
  "amenities": ["ac", "wifi", "music"],
  "additionalNotes": "Pickup near front entrance",
  "rideType": "recurring",
  "recurrenceDays": ["monday", "wednesday", "friday"],
  "recurrenceEndDate": "2026-01-31T04:59:59.999Z",
  "occurrenceStartTimes": [
    "2025-12-22T13:00:00.000Z",
    "2025-12-24T13:00:00.000Z",
    "2025-12-26T13:00:00.000Z"
  ],
  "seatsTotal": 1,
  "pricePerSeat": 22
}

###

###########################################
### ✏️ UPDATE RIDE (driver only)
# `pricePerSeat` is locked after ride creation and should not be sent here.
# For recurring rides, `scope` can be:
# - `occurrence` (default): only this ride row
# - `future`: this occurrence and all future rides in the same recurring series
# - `series`: every occurrence in the same recurring series
###########################################
PUT {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-20T08:00:00.000Z",
  "arrivalTime": "2025-12-21T08:00:00.000Z",
  "stops": ["Downtown", "Union Station"],
  "amenities": ["wifi", "pet_friendly"],
  "additionalNotes": "Luggage space available",
  "seatsTotal": 1,
  "scope": "occurrence"
}

###

### SEARCH RIDES (PUBLIC)
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
GET {{baseUrl}}/rides?fromCity=Waterloo&toCity=Toronto&seats=1
Accept: application/json

###

### SEARCH RIDES (GEOLOCATION)
GET {{baseUrl}}/rides?fromLat=43.4643&fromLng=-80.5204&toLat=43.6532&toLng=-79.3832&radiusKm=25&seats=1
Accept: application/json

###

### CREATE RECURRING RIDE (driver only)
# `rideType` should be `recurring`. The API also treats recurrence metadata as a
# recurring create request, so it will not silently downgrade to `one-time`.
POST {{baseUrl}}/rides
Authorization: Bearer {{driverAccessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-22T13:00:00.000Z",
  "seatsTotal": 3,
  "pricePerSeat": 22,
  "rideType": "recurring",
  "recurrenceDays": ["monday", "wednesday", "friday"],
  "recurrenceEndDate": "2026-01-31T04:59:59.999Z",
  "occurrenceStartTimes": [
    "2025-12-22T13:00:00.000Z",
    "2025-12-24T13:00:00.000Z",
    "2025-12-26T13:00:00.000Z"
  ],
  "stops": ["Downtown"],
  "amenities": ["wifi"],
  "additionalNotes": "Recurring commute"
}

###

### GET MY RIDES  (driver only)
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
# Recurring rides are still returned as one row per occurrence and linked by
# `recurringSeriesId`. Driver/admin UIs can group these rows into one recurring
# series card while keeping occurrence-level booking and status control.
GET {{baseUrl}}/rides/me/list
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### SET A RIDE ID FROM PREVIOUS RESPONSE
# Example:
# @rideId = 8cc76017-9a9e-4b4d-88fa-6761c2de1685


### GET RIDE BY ID
# Response includes `rideTiming`: PREBOOKED | ONTIME | STANDARD
GET {{baseUrl}}/rides/{{rideId}}
Accept: application/json

###

### UPDATE RIDE (driver only)
# `pricePerSeat` is locked after ride creation and should not be sent here.
# For recurring rides, `scope` can be:
# - `occurrence` (default)
# - `future`
# - `series`
PUT {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fromCity": "Waterloo",
  "fromLat": 43.4643,
  "fromLng": -80.5204,
  "toCity": "Toronto",
  "toLat": 43.6532,
  "toLng": -79.3832,
  "startTime": "2025-12-15T15:00:00.000Z",
  "arrivalTime": "2025-12-15T17:00:00.000Z",
  "stops": ["Union Station"],
  "amenities": ["wifi", "child_seat"],
  "additionalNotes": "One small luggage allowed",
  "seatsTotal": 4,
  "scope": "future"
}

###

### DELETE RIDE (driver only, hard delete)
# Keep using `/rides/:id/cancel` for driver/admin operational cancellation,
# especially for recurring occurrences. `DELETE /rides/:id` permanently removes
# the ride row.
DELETE {{baseUrl}}/rides/{{rideId}}
Authorization: Bearer {{accessToken}}

###

###########################################
### 🚦 RIDE LIFECYCLE (driver only)
###########################################
### START RIDE
POST {{baseUrl}}/rides/{{rideId}}/start
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### START RIDE (PUT alias)
PUT {{baseUrl}}/rides/{{rideId}}/start
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### COMPLETE RIDE
POST {{baseUrl}}/rides/{{rideId}}/complete
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### COMPLETE RIDE (PUT alias)
PUT {{baseUrl}}/rides/{{rideId}}/complete
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### CANCEL RIDE (with reason)
# Refund is initiated for all paid confirmed bookings.
# For recurring rides, `scope` can be:
# - `occurrence` (default)
# - `future`
# - `series`
POST {{baseUrl}}/rides/{{rideId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Driver unavailable",
  "scope": "occurrence"
}

###

### CANCEL RIDE (PUT alias)
# Refund is initiated for all paid confirmed bookings.
PUT {{baseUrl}}/rides/{{rideId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Driver unavailable",
  "scope": "series"
}

###

################################################
### 📩 BOOKINGS – PASSENGER & DRIVER
################################################

### SEARCH RIDES (pick one to book)
GET {{baseUrl}}/rides?fromCity=Waterloo&toCity=Toronto&seats=1
Accept: application/json

###

### CREATE BOOKING (PASSENGER REQUESTS RIDE)
POST {{baseUrl}}/bookings/{{rideId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "seats": 1,
  "passengerPickupName": "Conestoga Mall, Waterloo",
  "passengerPickupLat": 43.4723,
  "passengerPickupLng": -80.5449,
  "passengerDropoffName": "Union Station, Toronto",
  "passengerDropoffLat": 43.6532,
  "passengerDropoffLng": -79.3832
}

###

# Set from booking response
# @bookingId = 00000000-0000-0000-0000-000000000000

### GET MY BOOKINGS (PASSENGER)
GET {{baseUrl}}/bookings/me/list
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### DRIVER: GET BOOKINGS FOR A RIDE
GET {{baseUrl}}/bookings/ride/{{rideId}}
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### DRIVER: INBOX (PAGINATED BOOKINGS)
GET {{baseUrl}}/bookings/driver/me?status=pending&limit=50&cursor=
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### DRIVER: CONFIRM BOOKING
PUT {{baseUrl}}/bookings/{{bookingId}}/confirm
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### DRIVER: REJECT BOOKING
PUT {{baseUrl}}/bookings/{{bookingId}}/reject
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

### PASSENGER: CANCEL BOOKING
# If booking was paid, refund is initiated automatically only when cancelling
# more than 2 hours before departure. Within 2 hours, no refund is issued.
POST {{baseUrl}}/bookings/{{bookingId}}/cancel
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### PASSENGER: CANCEL BOOKING (PUT alias)
# If booking was paid, refund is initiated automatically only when cancelling
# more than 2 hours before departure. Within 2 hours, no refund is issued.
PUT {{baseUrl}}/bookings/{{bookingId}}/cancel
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### PASSENGER: CANCEL BOOKING (DELETE alias)
# If booking was paid, refund is initiated automatically only when cancelling
# more than 2 hours before departure. Within 2 hours, no refund is issued.
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### DRIVER: CANCEL PASSENGER BOOKING
# If booking was paid, refund is initiated automatically.
POST {{baseUrl}}/bookings/{{bookingId}}/driver-cancel
Authorization: Bearer {{driverAccessToken}}
Accept: application/json

###

################################################
### 💬 CHAT (PASSENGER ↔ DRIVER)
################################################

### CREATE / GET CONVERSATION (PASSENGER)
# Requires a paid/succeeded booking for this ride + passenger pair.
# Otherwise returns 403 with code CHAT_PAYMENT_REQUIRED.
POST {{baseUrl}}/chat/conversations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rideId": "{{rideId}}"
}

###

### CREATE / GET CONVERSATION (DRIVER)
# Requires a paid/succeeded booking for this ride + passenger pair.
# Otherwise returns 403 with code CHAT_PAYMENT_REQUIRED.
POST {{baseUrl}}/chat/conversations
Authorization: Bearer {{driverAccessToken}}
Content-Type: application/json

{
  "rideId": "{{rideId}}",
  "passengerId": "{{userId}}"
}

###

### LIST MY CONVERSATIONS
GET {{baseUrl}}/chat/conversations
Authorization: Bearer {{accessToken}}
Accept: application/json

# Response now includes ride-linked context such as:
# - rideReference
# - tripSummary
# - tripTime / tripTimeLabel
# - rideStatus
# - ridePricePerSeat
# - blockedByMe / blockedByOtherUser / paymentRequired / chatDisabled
# - nested ride object

###

# Set from conversation response
# @conversationId = 00000000-0000-0000-0000-000000000000

### LIST MESSAGES
GET {{baseUrl}}/chat/conversations/{{conversationId}}/messages?limit=50
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### MARK MESSAGES READ
POST {{baseUrl}}/chat/conversations/{{conversationId}}/read
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### SEND MESSAGE
POST {{baseUrl}}/chat/conversations/{{conversationId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": "Hey, I am at the pickup point."
}

###

### BLOCK CHAT USER
POST {{baseUrl}}/chat/users/{{driverId}}/block
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### UNBLOCK CHAT USER
DELETE {{baseUrl}}/chat/users/{{driverId}}/block
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### PUSHER AUTH (PRIVATE CHANNEL)
POST {{baseUrl}}/chat/pusher/auth
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "socket_id": "1234.5678",
  "channel_name": "private-conversation-{{conversationId}}"
}

###

