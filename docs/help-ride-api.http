### RESEND EMAIL VERIFICATION OTP
# Use `/auth/continue/email` from the new mobile auth entry flow when you
# want unified sign-in + sign-up behavior.
POST {{baseUrl}}/auth/verify-email/send-otp
Content-Type: application/json

{
  "email": "{{email}}"
}

###

### VERIFY EMAIL WITH OTP
# Replace {{otp}} with the 6-digit code from your email.
# Tokens are returned on success for verification or passwordless login.
POST {{baseUrl}}/auth/verify-email/verify-otp
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "112991"
}

###

### SEND PHONE VERIFICATION OTP (SMS)
# Use `/auth/login-phone/send-otp` from the login screen when you need
# a missing-account response instead of the generic verification flow.
# Test shortcut: the configured test phone uses OTP `123456` and skips SMS delivery.
POST {{baseUrl}}/auth/verify-phone/send-otp
Content-Type: application/json

{
  "phone": "{{phone}}"
}

###

### VERIFY PHONE WITH OTP (SMS)
# Replace {{otp}} with the 6-digit code from SMS.
# Tokens are returned on success for verification or passwordless login.
# For the configured test phone while TEST_PHONE_OTP is enabled, use `123456`.
POST {{baseUrl}}/auth/verify-phone/verify-otp
Content-Type: application/json

{
  "phone": "{{phone}}",
  "otp": "{{otp}}"
}

