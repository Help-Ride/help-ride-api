################################################
### 🔐 AUTH – PASSWORDLESS CONTINUE FLOW
################################################

### START PHONE CONTINUE FLOW
# Test shortcut: send `+11111111111` here, or enter `1111111111` in the app.
# When TEST_PHONE_OTP is enabled, the OTP is always `123456` and no SMS is sent.
POST {{baseUrl}}/auth/continue/phone
Content-Type: application/json

{
  "phone": "{{phone}}",
  "deviceId": "ios-simulator-auth-device"
}

###

### VERIFY PHONE CONTINUE FLOW
# Use OTP `123456` for the configured test phone while TEST_PHONE_OTP is enabled.
POST {{baseUrl}}/auth/continue/phone/verify
Content-Type: application/json

{
  "phone": "{{phone}}",
  "otp": "112991",
  "deviceId": "ios-simulator-auth-device"
}

###

### START EMAIL CONTINUE FLOW
POST {{baseUrl}}/auth/continue/email
Content-Type: application/json

{
  "email": "{{email}}",
  "deviceId": "ios-simulator-auth-device"
}

###

### VERIFY EMAIL CONTINUE FLOW
POST {{baseUrl}}/auth/continue/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "112991",
  "deviceId": "ios-simulator-auth-device"
}

###

### COMPLETE NEW-USER ONBOARDING
POST {{baseUrl}}/auth/onboarding/complete
Content-Type: application/json

{
  "onboardingToken": "onboardingToken",
  "firstName": "Rishi",
  "lastName": "Patel",
  "email": "{{email}}",
  "phone": "{{phone}}",
  "deviceId": "ios-simulator-auth-device"
}

