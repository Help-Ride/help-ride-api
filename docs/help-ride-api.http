################################################
### 💳 STRIPE PAYMENTS + CONNECT
################################################
# Passenger funds are collected into HelpRide Stripe account.
# Driver payouts are sent via Stripe Connect transfer from admin endpoint.

### CREATE PAYMENT INTENT (Passenger)
POST {{baseUrl}}/payments/intent
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "savePaymentMethod": false
}

###

# Creates a SetupIntent + CustomerSheet context for adding/removing saved cards.
### CREATE PAYMENT SETUP INTENT (Passenger)
POST {{baseUrl}}/payments/setup-intent
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Set from payment intent response
@paymentIntentId =

### GET PAYMENT INTENT STATUS (Passenger/Driver)
GET {{baseUrl}}/payments/intent/{{paymentIntentId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### CREATE/REFRESH STRIPE CONNECT ONBOARDING LINK (DRIVER)
POST {{baseUrl}}/stripe/connect/onboard
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### GET STRIPE CONNECT STATUS (DRIVER)
GET {{baseUrl}}/stripe/connect/status
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### CREATE STRIPE EXPRESS DASHBOARD LOGIN LINK (DRIVER)
POST {{baseUrl}}/stripe/connect/dashboard-link
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### RESET STRIPE CONNECT ACCOUNT + GET NEW ONBOARDING LINK (DRIVER, TEST ONLY)
POST {{baseUrl}}/stripe/connect/reset
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "confirm": "RESET_STRIPE_CONNECT"
}

###

# Set `state` from onboarding/refresh redirect URL query param
@connectState =

### STRIPE CONNECT REFRESH (PUBLIC REDIRECT ENDPOINT)
GET {{baseUrl}}/stripe/connect/refresh?state={{connectState}}
Accept: application/json

###

### STRIPE CONNECT RETURN (PUBLIC REDIRECT ENDPOINT)
# If STRIPE_CONNECT_APP_RETURN_URL is set, browser requests will be redirected
# back into the app, for example `helpride://stripe/return?...`.
GET {{baseUrl}}/stripe/connect/return?state={{connectState}}&format=json
Accept: application/json

###

### STRIPE WEBHOOK (LOCAL DEV - RUN IN TERMINAL)
# stripe listen --forward-to localhost:4000/api/webhooks/stripe

# Card number: 4242 4242 4242 4242
# Expiry: Any future date (e.g. 12/34)
# CVC: Any 3 digits (e.g. 123)
# ZIP / Postal: Any (e.g. A1A1A1 or 12345)

